+
+  test-linux:
+    # Core only. Core has no GPU code, so this runs on a plain runner and catches Linux-only
+    # differences (paths, float determinism, SQLite) that macOS misses. The render goldens stay
+    # out until they are pinned to a Mesa version (ADR 0008).
+    name: test (linux, core)
+    runs-on: ubuntu-24.04
+    steps:
+      - uses: actions/checkout@v4
+      - name: Install toolchain
+        run: rustup show active-toolchain || rustup toolchain install
+      - uses: Swatinem/rust-cache@v2
+      - run: cargo test -p ssmap-core --locked
